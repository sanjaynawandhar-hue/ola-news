# ---------------------------------------------------------------------------
# Ola News — environment configuration
#
# Copy to `.env` and adjust. Every value here is read on the SERVER only.
# Nothing in this file is exposed to the browser: there are no NEXT_PUBLIC_*
# variables in this project by design, so API keys can never leak into a
# client bundle.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# SQLite (default, zero-config local development). Relative paths are resolved
# against the project root.
DATABASE_URL="file:./dev.db"

# PostgreSQL (recommended for production). To switch:
#   1. npm run db:use-postgres      # flips the Prisma datasource provider
#   2. set DATABASE_URL below
#   3. npx prisma migrate dev --name init
#   4. npm run db:seed
# DATABASE_URL="postgresql://user:password@localhost:5432/ola_news?schema=public"


# --- Branding --------------------------------------------------------------
# Shown as "Prepared for …" in the dashboard footer, PNG cards and PPTX decks.
# Can also be changed at runtime in Settings, which overrides this value.
OLA_NEWS_BRAND_NAME="[YOUR NAME]"

# Path (under /public) to the logo used in the header and every export.
# Replace the bundled placeholder with the official Ola logo supplied by the
# brand owner, or one obtained from an authorised official source.
OLA_NEWS_LOGO_PATH="/branding/ola-logo.svg"

# Default display timezone. Indian Standard Time unless changed in Settings.
OLA_NEWS_TIMEZONE="Asia/Kolkata"


# --- Ingestion behaviour ---------------------------------------------------
# Identifies this collector to publishers. Keep it honest and contactable.
OLA_NEWS_USER_AGENT="OlaNewsBot/1.0 (executive news intelligence dashboard; respects robots.txt)"

# Per-request timeout and how many sources are contacted in parallel.
OLA_NEWS_FETCH_TIMEOUT_MS=15000
OLA_NEWS_MAX_CONCURRENCY=4

# Set to "false" to exclude the built-in labelled demo dataset entirely.
OLA_NEWS_ENABLE_DEMO_DATA=true

# debug | info | warn | error
OLA_NEWS_LOG_LEVEL=info


# --- API rate limiting -----------------------------------------------------
OLA_NEWS_RATE_WINDOW_MS=60000
OLA_NEWS_RATE_MAX=120
OLA_NEWS_REFRESH_RATE_MAX=6


# --- Optional: commercial news APIs ---------------------------------------
# Each key switches its connector from AWAITING_CREDENTIALS to LIVE.
# Without a key the source is skipped and reported as such — it is never
# filled with fabricated results.
# NEWSAPI_KEY=
# NEWSDATA_API_KEY=
# GNEWS_API_KEY=
# BING_NEWS_API_KEY=


# --- Optional: LLM enrichment ---------------------------------------------
# When set, summaries and the "why this matters" framing are written by Claude
# from the headline and the publisher's syndicated description only (the prompt
# forbids adding facts absent from the input). Without it, the local heuristic
# engine is used. Every record stores which engine produced its text.
# ANTHROPIC_API_KEY=
# OLA_NEWS_LLM_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
